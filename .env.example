# Copia este archivo como .env y llena los valores de tu proyecto de Supabase.
# Sin estas variables la app funciona igual, con todos los datos en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Dominios que ya usan Supabase (separados por coma). Vacío = todo local. Ej: identity
VITE_REMOTE_DOMAINS=
